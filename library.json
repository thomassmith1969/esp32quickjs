{
  "name": "QuickJS",
  "description": "QuickJS Javascript Engine for ESP32",
  "keywords": "JavaScript",
  "authors": [
    {
      "name": "Fabrice Bellard",
      "url": "https://bellard.org/quickjs/"
    },
    {
      "name": "binzume",
      "url": "https://github.com/binzume/esp32quickjs"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/binzume/esp32quickjs.git"
  },
  "version": "0.0.1",
  "framework": "*",
  "platforms": "espressif32",
  "dependencies": {
    "madhephaestus/ESP32Servo": "^3.2.1",
    "ServoEasing": "^3.6.0",
    "LittleFS": "^3.3.10",
    "SD": "^3.3.10",
    "Ticker": "^3.3.10",
    "madhephaestus/ESP32Encoder": "^0.12.0",
    "hideakitai/ESP32SPISlave": "^0.8.0",
    "gitlab-vishal1695/FastLED_min" :"^1.0.0",
    "mobizt/ESP_SSLClient": "^3.1.3",
    "arduino-libraries/ArduinoHttpClient" :"^0.6.1"
    
  },
  "build": {
    "flags": "-DCONFIG_VERSION=\\\"2020-11-08\\\"",
    "srcFilter": [
      "+<*.c>",
      "+<*.cpp>",
      "+<esp32/*.cpp>",
      "+<*.h>",
      "+<esp32/*.h>",
      "-<tests/>",
      "-<examples/>",
      "-<doc/>",
      "-<qjs.c>",
      "-<qjsc.c>",
      "-<quickjs-libc.c>",
      "-<quickjs-libc.h>",
      "-<unicode_gen.c>",
      "-<run-test262.c>"
    ]
  }
}